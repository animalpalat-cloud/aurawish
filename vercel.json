{
  "redirects": [
    {
      "source": "/create-birthday-card",
      "destination": "/birthday-card-maker",
      "permanent": true
    },
    {
      "source": "/online-birthday-card-maker",
      "destination": "/birthday-card-maker",
      "permanent": true
    },
    {
      "source": "/personalized-birthday-cards",
      "destination": "/birthday-card-maker",
      "permanent": true
    },
    {
      "source": "/categories/:slug",
      "destination": "/category/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|.*\\.(?:ico|png|svg|xml|txt|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
